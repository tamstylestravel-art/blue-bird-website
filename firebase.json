{
  "hosting": {
    "source": ".",
    "cleanUrls": true,
    "redirects": [
      {
        "source": "/",
        "destination": "/th",
        "type": 301
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
